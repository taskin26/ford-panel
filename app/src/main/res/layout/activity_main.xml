<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b1f33">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Ust serit: durum + WiFi/Bluetooth baglan butonlari (panel uzerinde hep gorunur) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC0b1f33"
        android:paddingLeft="10dp"
        android:paddingRight="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <Button
            android:id="@+id/homeBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="44dp"
            android:text="⌂"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:backgroundTint="#37474f"
            android:layout_marginEnd="6dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />

        <TextView
            android:id="@+id/durum"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FORD"
            android:textColor="#d0e4ff"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <Button
            android:id="@+id/wifiBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="WiFi ile Bağlan"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:backgroundTint="#2e7d32"
            android:layout_marginEnd="6dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />

        <Button
            android:id="@+id/btBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Bluetooth ile Bağlan"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:backgroundTint="#1565c0"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />
    </LinearLayout>
</FrameLayout>
